{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@/network/*": ["platform-app/src/network/*"],
      "@/business/*": ["platform-app/src/business/*"],
      "@/dashboard/*": ["platform-app/src/dashboard/*"],
      "@/platform/*": ["platform-app/src/platform/*"],
      "@/lib/auth": ["platform-app/src/auth.tsx"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
